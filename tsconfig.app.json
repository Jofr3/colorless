{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["src"],
  // The seam suites run web client code against the api's, which needs the Workers types too.
  "exclude": ["src/seam"],
  "references": [{ "path": "./packages/engine" }, { "path": "./packages/schema" }]
}
