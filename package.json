{
  "name": "colorless",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun run build:lua && vite --host 127.0.0.1 --port 5175 --strictPort",
    "dev:all": "bun run --parallel dev api:dev",
    "dev:tailnet": "bun scripts/dev-tailnet.ts",
    "build": "tsc -b && bun run build:lua && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome lint .",
    "lint:coverage": "bun scripts/lint-coverage.ts",
    "typecheck:coverage": "bun scripts/typecheck-coverage.ts",
    "format": "biome format . --write",
    "test": "vitest",
    "test:run": "vitest run",
    "format:check": "biome format .",
    "test:lua": "bun scripts/test-lua.ts",
    "lua-constants:check": "bun scripts/lua-constants.ts --check",
    "mutants:precheck": "bun scripts/mutation/precheck.ts",
    "check": "bun run check:static && bun run check:lua && bun run check:test",
    "check:static": "bun scripts/typecheck-coverage.ts && tsc -b && bun scripts/lint-coverage.ts && biome ci . --error-on-warnings && bun scripts/lua-constants.ts --check && bun scripts/mutation/precheck.ts",
    "check:lua": "bun scripts/test-lua.ts --require-source",
    "check:test": "vitest run",
    "mutants": "bun scripts/mutation/run.ts",
    "api:dev": "bun run --cwd apps/api dev",
    "api:deploy": "bun run --cwd apps/api deploy",
    "build:lua": "node frontend/lua/build.mjs",
    "deploy": "bun run build && wrangler deploy",
    "release": "bun run check && bun run --cwd apps/api db:migrate:remote && bun run api:deploy && bun run deploy"
  },
  "dependencies": {
    "@colorless/engine": "workspace:*",
    "@colorless/schema": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.9",
    "wrangler": "^4.0.0"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
