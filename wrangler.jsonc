{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The web frontend: a static-assets-only Worker (no script) serving the
  // Vite build. `bun run deploy` builds it in production mode, which reads
  // VITE_API_ORIGIN from .env.production; the api (apps/api) lists this
  // Worker's origin as its APP_ORIGIN.
  "name": "colorless",
  "compatibility_date": "2026-06-01",
  // No per-version preview URLs: only the deployed version is reachable.
  "preview_urls": false,
  "assets": {
    // dist/.assetsignore (copied from public/) keeps the hidden source maps out.
    "directory": "./dist",
    // Every page path (/decks, /online/CODE, …) gets the host page, which
    // routes on the path; unknown paths open home.
    "not_found_handling": "single-page-application"
  }
}
