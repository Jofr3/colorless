{
  // Dev tooling. Scripts import engine sources by relative path, so those are typechecked again
  // here rather than through a project reference (which would need the engine to emit).
  // `bun:sqlite` is typed by scripts/bun-runtime.d.ts.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "scripts",
    "apps/api/scripts",
    "packages/schema/scripts",
    "apps/api/drizzle.config.ts"
  ]
}
