{
  // Dev tooling. The engine and schema are read through their declarations; the api sources the
  // scripts import are typechecked here again. `bun:sqlite` is typed by scripts/bun-runtime.d.ts.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "scripts",
    "apps/api/scripts",
    "packages/schema/scripts",
    "apps/api/drizzle.config.ts"
  ],
  "references": [{ "path": "./packages/engine" }, { "path": "./packages/schema" }]
}
