{
  "$comment": "Loop-only settings. Passed via `claude --settings` by loop.sh so these hooks never fire in your interactive sessions. /home/jofre/projects/luminous_ui is substituted with the repo path at launch.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/jofre/projects/luminous_ui/scripts/autoloop/hooks/context-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/jofre/projects/luminous_ui/scripts/autoloop/hooks/session-gate.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
