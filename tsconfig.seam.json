{
  // The seam suites (src/seam): the web client's sources run against the api's through its
  // `./testing/*` exports, so both are typechecked here again, with the DOM and the Workers types.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "@cloudflare/workers-types"]
  },
  "include": ["src/seam"],
  "references": [{ "path": "./packages/engine" }, { "path": "./packages/schema" }]
}
