{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colorless-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // No per-version preview URLs, so an old API version never runs against production D1.
  // (Workers with a Durable Object get none today; this keeps it that way.)
  "preview_urls": false,
  // The `deploy` script minifies (`wrangler deploy --minify`; `wrangler dev` stays readable), so
  // the source maps go up with it and Workers Logs resolves a stack trace to source. Function and
  // class names survive minification (wrangler's keep_names default), which error logging reads.
  // `scripts/worker-bundle.ts --check` fails without either (dependency audit USE1).
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  // The running version's id and its `--tag` (the commit's short sha, which
  // scripts/release-gate.ts passes to `wrangler deploy`), returned by GET /health so the
  // live commit can be named and `release:health` can wait for the new version (build audit ENV1).
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    // The web app's origin: CORS allow-origin (credentialed) + OAuth
    // post-login redirect target (§3.5). Production is the static frontend
    // Worker (root wrangler.jsonc); the `dev` script overrides it with
    // `--var APP_ORIGIN:http://localhost:5175` for `bun run dev`, and
    // scripts/dev-tailnet.ts appends its own (the last --var wins). OAuth
    // secrets are NOT vars — install via `wrangler secret put GOOGLE_CLIENT_ID` etc.
    "APP_ORIGIN": "https://colorless.jofrescari.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "colorless",
      "database_id": "f84cf768-0fd9-49bf-a3a6-175622b0fd61",
      // drizzle-kit writes its generated SQL here (drizzle.config.ts `out`);
      // pointing wrangler at the same dir makes `d1 migrations apply` pick
      // them up directly — no copying step.
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      // Lazily-mirrored tcgdex assets (D9): populated cache-aside by the
      // GET /assets/* routes, never by a backfill job. `wrangler dev`
      // simulates the bucket locally under .wrangler/state.
      "binding": "ASSETS",
      "bucket_name": "colorless-assets"
    }
  ],
  "triggers": {
    // The daily sweep of expired sessions and sign-in counters (src/auth/sweep.ts), at an
    // off-peak minute rather than on the hour.
    "crons": ["17 4 * * *"]
  },
  "ratelimits": [
    {
      // Per-IP limits on lobby creation and the lobby WebSocket upgrade (src/lobby/routes.ts,
      // which justifies the numbers). `namespace_id` is any positive integer unique within the
      // Cloudflare account; `period` may only be 10 or 60 seconds.
      "name": "LOBBY_CREATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "LOBBY_SOCKET_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      // Per (scope, IP) ahead of the D1 sign-in limiter on register, login and account deletion
      // (src/auth/routes.ts): a flood is refused before it spends a D1 write.
      "name": "AUTH_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Deck writes per account and per IP (src/decks/routes.ts, which justifies the numbers).
      "name": "DECK_WRITE_LIMIT",
      "namespace_id": "1005",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "DECK_WRITE_IP_LIMIT",
      "namespace_id": "1006",
      "simple": { "limit": 180, "period": 60 }
    },
    {
      // Per-IP limit on GET /cards queries that scan the catalog (src/catalog/searchLimit.ts,
      // which justifies the number).
      "name": "CATALOG_SEARCH_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "kv_namespaces": [
    {
      // Response cache for the public catalog GETs (§3.3/§6): cache-aside,
      // keyed by the ingest epoch plus normalized path+query. Simulated locally by
      // `wrangler dev` under .wrangler/state.
      "binding": "CACHE",
      "id": "e9954577422e4f8b91318efc3f45f55a"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        // The lobby server (§3.6): one LobbyDO instance per lobby code
        // (idFromName), WebSocket + hibernation, running the shared
        // lobbyReducer. Class exported from src/index.ts.
        "name": "LOBBY",
        "class_name": "LobbyDO"
      }
    ]
  },
  "migrations": [
    {
      // SQLite-backed storage for LobbyDO (the modern default; the KV-style
      // storage API rides on it).
      "tag": "v1",
      "new_sqlite_classes": ["LobbyDO"]
    }
  ]
}
