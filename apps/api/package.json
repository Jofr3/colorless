{
  "name": "@colorless/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "CI=true bun run db:migrate:local && bun ../../scripts/with-system-certs.ts wrangler dev --var APP_ORIGIN:http://localhost:5175",
    "deploy": "bun scripts/release-gate.ts migrations && wrangler deploy",
    "release:gate": "bun scripts/release-gate.ts bookmark print-keys",
    "db:check": "bun scripts/db-check.ts",
    "typecheck": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "bun ../../scripts/with-system-certs.ts wrangler d1 migrations apply colorless --local",
    "db:migrate:remote": "wrangler d1 migrations apply colorless --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@colorless/engine": "workspace:*",
    "@colorless/schema": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@tcgdex/sdk": "2.9.0",
    "drizzle-kit": "^0.31.10",
    "miniflare": "4.20260708.0",
    "wrangler": "^4.0.0"
  }
}
