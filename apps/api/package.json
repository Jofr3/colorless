{
  "name": "@colorless/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./testing/lobbyHarness": "./src/testing/lobbyHarness.ts",
    "./testing/contract": "./src/testing/contract.ts",
    "./testing/fixtureCatalog": "./src/testing/fixtureCatalog.ts"
  },
  "scripts": {
    "dev": "CI=true bun run db:migrate:local && bun ../../scripts/with-system-certs.ts wrangler dev --var APP_ORIGIN:http://localhost:5175",
    "deploy": "bun scripts/release-gate.ts migrations clean-tree ci -- wrangler deploy --minify",
    "release:gate": "bun scripts/release-gate.ts pin clean-tree audit ci secrets bookmark versions print-keys",
    "release:health": "bun scripts/release-gate.ts health",
    "release:finish": "bun scripts/release-gate.ts finish",
    "db:check": "bun scripts/db-check.ts",
    "typecheck": "tsc -b",
    "types": "rm -f worker-configuration.d.ts && wrangler types --env-file=/dev/null --env-interface=GeneratedEnv",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "bun ../../scripts/with-system-certs.ts wrangler d1 migrations apply colorless --local",
    "db:migrate:remote": "wrangler d1 migrations apply colorless --remote"
  },
  "dependencies": {
    "@colorless/engine": "workspace:*",
    "@colorless/schema": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tcgdex/sdk": "2.9.0",
    "drizzle-kit": "^0.31.11",
    "miniflare": "5.20261104.0-beta",
    "wrangler": "^4.158.0"
  }
}
