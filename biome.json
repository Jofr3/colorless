{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "maxSize": 8388608,
    "includes": [
      "**/src/**",
      "**/apps/**",
      "**/packages/**",
      "**/scripts/**",
      "**/vite.config.ts",
      "**/vitest.config.ts",
      "**/frontend/**",
      "!**/node_modules",
      "!**/dist",
      "!**/public",
      "!**/*.tsbuildinfo",
      "!**/.wrangler",
      "!**/apps/api/worker-configuration.d.ts",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useExponentiationOperator": "off"
      },
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/apps/api/src/lobby/**",
        "!**/apps/api/src/lobby/match.ts",
        "!**/apps/api/src/lobby/**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@colorless/engine": "Only lobby/match.ts imports the engine; add the seam there."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/apps/api/src/**",
        "!**/apps/api/src/**/*.test.ts",
        "!**/apps/api/src/testing/**",
        "!**/apps/api/src/ingest/payloadCache.ts",
        "!**/apps/api/src/ingest/sqlFile.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "process": "The Worker runs without nodejs_compat; read config from the Env bindings.",
                  "Buffer": "The Worker runs without nodejs_compat; use Uint8Array, TextEncoder or btoa/atob.",
                  "__dirname": "The Worker has no file system or module paths.",
                  "__filename": "The Worker has no file system or module paths.",
                  "require": "The Worker is an ES module; use import.",
                  "global": "Use globalThis."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/frontend/lua/**"],
      "linter": {
        "rules": {
          "style": {
            "useSingleVarDeclarator": "off",
            "useNumberNamespace": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/mutation/mutants.ts", "**/scripts/mutation/binding-gate.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
